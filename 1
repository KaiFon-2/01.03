1 Пример
import kotlinx.coroutines.*

fun main() = runBlocking {
    println("Старт")

    // launch запускает корутину, но не возвращает результат
    launch {
        delay(1000) // имитация долгой работы (1 сек)
        println("Задача выполнена")
    }

    println("Делаю что-то параллельно...")
    delay(1500) // ждём, чтобы main не завершился раньше
    println("Конец")
}
